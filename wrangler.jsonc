{
  "name": "karvfan",
  "compatibility_date": "2026-08-18",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "karvfan.ir",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "SURVEY_DB",
      "database_name": "karfan-survey-db",
      "database_id": "b82a5bf5-590e-47cb-9ef3-6276274e960d"
    }
  ],
  "vars": {
    "SURVEY_ADMIN_TOKEN": "CLD6haM9cxpJttV9uBrquz7hsK9gEbaB"
  }
}
