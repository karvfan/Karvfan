{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "globals": {
    "sb": "writable",
    "supabase": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn"
  }
}
